{
	"name": "acp-headroom-pi",
	"version": "0.2.0",
	"description": "Fusion of billion-context-pi (model-driven context management) and headroom (mechanical payload compression) for the Pi coding agent.",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"postinstall": "node scripts/patch-upstream.mjs",
		"test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
		"typecheck": "tsc --noEmit",
		"build": "tsup && tsc --emitDeclarationOnly",
		"upstream": "npm update billion-context-pi headroom-ai"
	},
	"keywords": [
		"pi-package",
		"pi",
		"acp",
		"headroom",
		"context",
		"compression",
		"context-management",
		"llm",
		"pi-extension"
	],
	"author": "wentaonb123",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wentaonb123/acp-headroom-pi.git"
	},
	"homepage": "https://github.com/wentaonb123/acp-headroom-pi#readme",
	"bugs": {
		"url": "https://github.com/wentaonb123/acp-headroom-pi/issues"
	},
	"type": "module",
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"dependencies": {
		"billion-context-pi": "^0.1.56",
		"headroom-ai": "^0.37.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@types/node": "^26.1.2",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.27.7": true,
		"protobufjs@7.6.5": true,
		"@google/genai@1.52.0": true
	}
}
